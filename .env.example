# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# [CLIENT TO PROVIDE] Where enquiry form submissions are forwarded (CRM / Zapier / Make / n8n webhook).
# Receives a JSON POST. Without it, enquiries are rejected in production so no lead is silently lost.
ENQUIRY_WEBHOOK_URL=

# [CLIENT TO PROVIDE] WhatsApp number in international format, digits only (e.g. 60123456789).
# Leave empty and the floating button scrolls to the enquiry form instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
