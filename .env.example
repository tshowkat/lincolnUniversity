# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# [CLIENT TO PROVIDE] Where enquiry form submissions are forwarded (CRM / Zapier / Make / n8n webhook).
# Receives a JSON POST. Without it, enquiries are rejected in production so no lead is silently lost.
ENQUIRY_WEBHOOK_URL=

# [CLIENT TO PROVIDE] WhatsApp number in international format, digits only (e.g. 60123456789).
# Leave empty and the floating button scrolls to the enquiry form instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Chat assistant (Claude). Get a key at https://console.anthropic.com. Without it the chat replies that it is not set up.
ANTHROPIC_API_KEY=

# LUC ODL Admin Portal lead API (e.g. https://luc-odl-admin.vercel.app/api/leads) and its shared key.
# Enquiries go here; finished chat exchanges go to the same portal's /api/chats so staff can read them.
LEADS_API_URL=
LEADS_API_KEY=
# Optional: override where chats are stored (defaults to LEADS_API_URL with /api/leads replaced by /api/chats).
CHAT_LOG_URL=
